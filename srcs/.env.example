# ── PolyAgents Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# For local development, defaults are provided for Supabase.

# ── Supabase ──────────────────────────────────────────────────────────
# Local Supabase (run `supabase start` to get these values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── Privy (Wallet Auth) ───────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Polymarket CLOB ───────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_PRIVATE_KEY=
POLYMARKET_LIVE=false

# ── AI ─────────────────────────────────────────────────────────────────
# The frontend never calls an AI provider directly — it delegates to the Rust
# engine HTTP API (NEXT_PUBLIC_ENGINE_URL). AI provider config (Craftshost /
# gemma4:12b) lives with the engine; see the root .env.example.

# ── Database (docker-compose) ─────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
