# ── PolyAgents Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# These are the frontend-facing vars; see the root .env.example for the
# full engine / AI / Polymarket / vault-encryption configuration.

# ── Privy (Wallet Auth) ───────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Polymarket CLOB ───────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_PRIVATE_KEY=
POLYMARKET_LIVE=false

# ── AI ─────────────────────────────────────────────────────────────────
# The frontend never calls an AI provider directly — it delegates to the Rust
# engine HTTP API (NEXT_PUBLIC_ENGINE_URL). AI provider config (Craftshost /
# gemma4:12b) lives with the engine; see the root .env.example.

# ── Frontend → Engine URL ─────────────────────────────────────────────
# REQUIRED at build time (inlined into the browser bundle).
NEXT_PUBLIC_ENGINE_URL=http://localhost:8080

# ── Postgres (docker-compose db service) ──────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=polyagents
