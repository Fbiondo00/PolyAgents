{
  "_comment": "Template — copy to .mcp.json (gitignored) and fill in real values. .mcp.json holds DB passwords so it must never be committed.",
  "mcpServers": {
    "terraform": {
      "type": "stdio",
      "command": "/Users/ppezz/go/bin/terraform-mcp-server",
      "args": [
        "stdio"
      ],
      "env": {
        "TFE_TOKEN": "",
        "TFE_ADDRESS": "https://app.terraform.io"
      }
    },
    "postagents": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:YOUR_DB_PASSWORD@your-db-host:16543/postgres"
      ]
    }
  }
}
