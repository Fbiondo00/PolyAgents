# Privy
# Get your App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Hedera
# Get free testnet credentials at https://portal.hedera.com
HEDERA_OPERATOR_ID=0.0.XXXXXX
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...
HEDERA_NETWORK=testnet
# HBAR micropayment recipient (omit for self-pay demo)
HEDERA_PAYMENT_RECIPIENT=0.0.XXXXXX

# Arc (EVM L1 — USDC gas)
# Get testnet USDC from https://faucet.testnet.arc.network
ARC_PRIVATE_KEY=0x...
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
POLYAGENTS_CONTRACT_ADDRESS=0x...
ARC_NETWORK=local   # "local" for Anvil dev; "testnet" for Arc testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
CIRCLE_API_KEY=KIT_KEY:...   # Circle Developer Portal → Bridge Kit API key (CCTP)

# ENS (Sepolia)
# Get Sepolia ETH from https://sepoliafaucet.com
NEXT_PUBLIC_ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_ENS_OWNER_PRIVATE_KEY=0x...
NEXT_PUBLIC_ENS_BASE_DOMAIN=polyagents.eth

# Polymarket (Polygon mainnet — no testnet exists)
# Set POLYMARKET_LIVE=true only if you have a funded Polygon wallet
POLYMARKET_LIVE=false
POLYMARKET_PRIVATE_KEY=0x...           # Polygon wallet with USDC.e (only if LIVE=true)
POLYMARKET_API_KEY=                    # From Polymarket (only if LIVE=true)
POLYMARKET_API_SECRET=                 # From Polymarket (only if LIVE=true)
POLYMARKET_API_PASSPHRASE=             # From Polymarket (only if LIVE=true)
POLYMARKET_FUNDER_PRIVATE_KEY=0x...    # Polymarket funder address (only if LIVE=true)

# Vercel AI Gateway
# Get your API key from https://vercel.com
VERCEL_AI_API_KEY=vck_xxxxx
VERCEL_AI_GATEWAY_URL=https://gateway.vercel.ai
VERCEL_AI_DEFAULT_MODEL=gemini-3-flash-preview
VERCEL_AI_MAX_TOKENS=4096
