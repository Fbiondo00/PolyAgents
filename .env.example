# ── PolyAgents Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values.
# For local development, defaults are provided for Supabase.

# ── Supabase ──────────────────────────────────────────────────────────
# Local Supabase (run `supabase start` to get these values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── Privy (Wallet Auth) ───────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Polymarket CLOB ───────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_PRIVATE_KEY=
POLYMARKET_LIVE=false

# ── AI (Vercel AI SDK) ────────────────────────────────────────────────
VERCEL_AI_API_KEY=
VERCEL_AI_DEFAULT_MODEL=
VERCEL_AI_MAX_TOKENS=

# ── Database (docker-compose) ─────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
