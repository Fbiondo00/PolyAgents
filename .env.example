# ── PolyAgents Environment Variables ──────────────────────────────────
# Copy to .env: cp .env.example .env
# Fill in the placeholder values marked with <GET_FROM_...>

# ── Supabase ──────────────────────────────────────────────────────────
# Get these from `supabase start` output (local) or https://supabase.com/dashboard (cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<GET_FROM_SUPABASE_DASHBOARD>
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<GET_FROM_SUPABASE_DASHBOARD>

# ── Privy (Wallet Auth) ───────────────────────────────────────────────
# https://dashboard.privy.io → select app → API Keys
NEXT_PUBLIC_PRIVY_APP_ID=<GET_FROM_PRIVY_DASHBOARD>

# ── Polymarket CLOB ───────────────────────────────────────────────────
# Generate API key: https://polymarket.com → Profile → API Keys
# Generate private key: openssl rand -hex 32 (or use an existing EOA wallet private key)
POLYMARKET_API_KEY=<GET_FROM_POLYMARKET_PROFILE>
POLYMARKET_API_SECRET=<GET_FROM_POLYMARKET_PROFILE>
POLYMARKET_API_PASSPHRASE=<GET_FROM_POLYMARKET_PROFILE>
POLYMARKET_PRIVATE_KEY=<GENERATE_WITH_openssl_rand_-hex_32>
POLYMARKET_FUNDER_PRIVATE_KEY=<GENERATE_WITH_openssl_rand_-hex_32_OR_LEAVE_EMPTY>
POLYMARKET_LIVE=false

# ── AI (Rust engine) ──────────────────────────────────────────────────
OPENAI_API_BASE=https://openai.pezserv.org
OPENAI_API_KEY=<GET_FROM_OPENAI_OR_PROVIDER>
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024

# ── Database (Rust engine) ────────────────────────────────────────────
# Local dev: postgres://postgres:postgres@localhost:5432/postgres
# Production: output from Terraform (rds_endpoint)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ── Per-Vault Encryption ──────────────────────────────────────────────
# Generate: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=<GENERATE_WITH_openssl_rand_-hex_32>
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# ── Database (docker-compose) ─────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── AWS (Terraform) ──────────────────────────────────────────────────
# AWS credentials come from ~/.aws/credentials or env vars
# https://us-east-1.console.aws.amazon.com/iam → Access keys
AWS_REGION=us-east-1
AWS_INSTANCE_TYPE=t3.medium
AWS_RDS_INSTANCE_CLASS=db.t3.micro
