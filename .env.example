# ── PolyAgents Environment Variables ──────────────────────────────────
# Copy to .env: cp .env.example .env
# Fill in the placeholder values marked with <GET_FROM_...>

# ── Privy (Wallet Auth) ───────────────────────────────────────────────
# NEXT_PUBLIC_PRIVY_APP_ID is REQUIRED at build time (inlined into the bundle).
# https://dashboard.privy.io → select app → API Keys
NEXT_PUBLIC_PRIVY_APP_ID=<GET_FROM_PRIVY_DASHBOARD>

# ── Polymarket CLOB ───────────────────────────────────────────────────
# Generate API key: https://polymarket.com → Profile → API Keys
# Generate private key: openssl rand -hex 32 (or use an existing EOA wallet private key)
POLYMARKET_API_KEY=<GET_FROM_POLYMARKET_PROFILE>
POLYMARKET_API_SECRET=<GET_FROM_POLYMARKET_PROFILE>
POLYMARKET_API_PASSPHRASE=<GET_FROM_POLYMARKET_PROFILE>
POLYMARKET_PRIVATE_KEY=<GENERATE_WITH_openssl_rand_-hex_32>
POLYMARKET_FUNDER_PRIVATE_KEY=<GENERATE_WITH_openssl_rand_-hex_32_OR_LEAVE_EMPTY>
POLYMARKET_LIVE=false

# ── AI (Rust engine) ──────────────────────────────────────────────────
# Craftshost (OpenAI-compatible gateway). Key is the `sk-...` secret half.
OPENAI_API_BASE=https://openai.craftshost.com
OPENAI_API_KEY=<GET_FROM_CRAFTSHOST_SECRET_KEY>
# Required by Langfuse-routed gateways (Craftshost). The `pk-...` half of the key pair.
OPENAI_PUBLIC_KEY=<GET_FROM_CRAFTSHOST_PUBLIC_KEY>
OPENAI_MODEL=gemma4:12b
OPENAI_MAX_TOKENS=4096

# ── Database (Rust engine) ────────────────────────────────────────────
# The engine reads DATABASE_URL and applies its SQL migrations on boot.
# In docker compose the engine service overrides this to reach the `db`
# container by name (postgres://postgres:${POSTGRES_PASSWORD}@db:5432/...),
# so this value only matters for local `cargo run` against a reachable Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ── Per-Vault Encryption ──────────────────────────────────────────────
# Generate: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=<GENERATE_WITH_openssl_rand_-hex_32>
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# ── Postgres (docker-compose db service) ──────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=polyagents

# ── Frontend → Engine URL ─────────────────────────────────────────────
# REQUIRED at BUILD time (inlined into the browser bundle — NEXT_PUBLIC_*).
# Must be the address a user's browser uses to reach the engine API.
# Local dev / single-host prod: http://localhost:8080
# Real prod:                     https://your-domain:8080
NEXT_PUBLIC_ENGINE_URL=http://localhost:8080
